{
  "name": "@ticketto/binding-offchain",
  "version": "0.0.0",
  "description": "The SDK binding to the hosted `ticketto-offchain` ledger service.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KippuRocks/libticketto.git",
    "directory": "packages/binding-offchain"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/hermes/tsconfig.json",
    "test:hermes": "node test/hermes/run.ts",
    "vectors:vendor": "test/c4/vendor.sh",
    "vectors:check": "test/c4/vendor.sh --check"
  },
  "dependencies": {
    "@ticketto/profile-v0": "workspace:*",
    "@ticketto/sdk": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@types/node": "24.13.4",
    "hermes-compiler": "250829098.0.17",
    "metro": "0.87.1"
  }
}
