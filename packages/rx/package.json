{
  "name": "@ticketto/rx",
  "version": "0.0.0",
  "description": "Optional RxJS adapter: SDK write completion and log hints as Observables, so the SDK itself never depends on RxJS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KippuRocks/libticketto.git",
    "directory": "packages/rx"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ticketto/sdk": "workspace:*"
  },
  "peerDependencies": {
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "rxjs": "7.8.2"
  }
}
