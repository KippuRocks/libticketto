{
  "name": "@ticketto/profile-v0",
  "version": "0.0.0",
  "description": "The V0 cryptographic profile: credential verification, identity derivation, access pass format, and canonical encoding.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KippuRocks/libticketto.git",
    "directory": "packages/profile-v0"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json",
    "./vectors/v0.json": "./vectors/v0.json"
  },
  "files": [
    "dist",
    "vectors"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/hermes/tsconfig.json",
    "test:hermes": "node test/hermes/run.ts",
    "bench": "BENCH=1 vitest run --root . --silent=false --reporter=verbose src/pass.bench.test.ts",
    "bench:hermes": "node test/hermes/run.ts bench",
    "vectors:generate": "TICKETTO_WRITE_VECTORS=1 vitest run --root . src/vectors.test.ts"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@types/node": "24.13.4",
    "@types/qrcode": "1.5.6",
    "@virtonetwork/authenticators-webauthn": "1.2.7",
    "@virtonetwork/signer": "1.3.3",
    "hermes-compiler": "250829098.0.17",
    "metro": "0.87.1",
    "qrcode": "1.5.4"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@ticketto/sdk": "workspace:*",
    "scale-ts": "1.6.1"
  }
}
