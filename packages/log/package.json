{
  "name": "@ticketto/log",
  "version": "0.0.0",
  "description": "The published log: record and checkpoint format, hash chain, export and import.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KippuRocks/libticketto.git",
    "directory": "packages/log"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./vectors/v0.json": "./vectors/v0.json"
  },
  "files": [
    "dist",
    "vectors",
    "FORMAT.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "vectors:generate": "TICKETTO_WRITE_VECTORS=1 vitest run --root . src/vectors.test.ts"
  },
  "dependencies": {
    "@ticketto/profile-v0": "workspace:*",
    "@ticketto/sdk": "workspace:*"
  },
  "devDependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@types/node": "24.13.4"
  }
}
