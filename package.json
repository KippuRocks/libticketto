{
  "name": "libticketto",
  "version": "0.0.0",
  "private": true,
  "description": "The Ticketto monorepo: SDK surface, V0 cryptographic profile, ledger rules, conformance suite, reference backend, log, and backend bindings",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "lint": "biome ci .",
    "lint:switches": "node tools/switch-default/dist/cli.js",
    "format": "biome check --write .",
    "test": "vitest run",
    "boundaries": "node tools/boundaries/dist/cli.js",
    "spec:check": "node tools/spec-codegen/dist/cli.js check",
    "spec:generate": "node tools/spec-codegen/dist/cli.js generate",
    "spec:vendor": "node tools/spec-codegen/dist/cli.js vendor",
    "hermes": "pnpm --filter @libticketto/hermes-bundle hermes",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "canary": "pnpm --filter @libticketto/canary canary",
    "conformance-matrix": "node tools/conformance-matrix/dist/cli.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@changesets/cli": "3.0.2",
    "@types/node": "24.13.4",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
